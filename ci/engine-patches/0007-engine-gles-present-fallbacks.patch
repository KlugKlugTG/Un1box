From a4a94b455fa8dd3480787881ca5cc2da99f4fb75 Mon Sep 17 00:00:00 2001
From: Un1box <un1box@localhost>
Date: Sun, 25 Oct 2026 19:22:43 +0000
Subject: [PATCH 2/2] gles: cheaper presents on the paths that copy on the vCPU

Three per-frame costs on the present paths that do their copy here:

- The readback present drained the pipeline with glFinish() before
  glReadPixels. glReadPixels is already the sync point for the pixels it reads,
  so that was the same double wait the AHardwareBuffer path was added to remove
  (gles_ahb_lock explains it). LT_READBACK_FINISH=on brings it back for a
  driver that tests badly. This is the path of a 16-bit CoreAnimation surface
  (the iPod touch 2G), of EGL hosts without the AHardwareBuffer extensions and
  of every run that asks for the old readback in order to time it.

- gles_frame_lock flushed before taking the platform lock. The AHardwareBuffer
  lock submits the frame itself now (the native fence after a flush, or the
  glFinish fallback), so on Android the frame was submitted twice per present.

- The RGBA-to-BGRA swap of a row, which runs over every pixel of every frame on
  a driver that refused BGRA storage for the surface, is four pixels a table
  shuffle on AArch64, as the Android presenter's own convert already is.
---
 hw/arm/gles-host.c | 52 +++++++++++++++++++++++++++++++++++++++++++---
 1 file changed, 49 insertions(+), 3 deletions(-)

diff --git a/hw/arm/gles-host.c b/hw/arm/gles-host.c
index 985a0f8..69996e0 100644
--- a/hw/arm/gles-host.c
+++ b/hw/arm/gles-host.c
@@ -42,6 +42,9 @@ extern bool it_profile_on;
 #include "exec/tb-flush.h"
 #include "tcg/tcg.h"
 #include "qemu/units.h"
+#if defined(__aarch64__)
+#include <arm_neon.h>       /* gles_frame_row: four pixels a byte shuffle */
+#endif
 #include "qemu/error-report.h"
 #include "hw/core/sysbus.h"
 #include "hw/arm/ipod_touch_2g.h"
@@ -3157,10 +3160,36 @@ static const uint8_t *gles_frame_lock(size_t *stride)
     if (!gh.iosurface) {
         return NULL;
     }
-    glFlush();
+#ifdef GLES_HOST_AHB
+    /* The AHardwareBuffer lock submits the frame itself -- the native fence after a flush, or a
+     * glFinish -- so flushing here as well submitted it twice. */
+    if (!gh.ahb.buffer)
+#endif
+    {
+        glFlush();
+    }
     return gles_platform_frame_lock(stride);
 }
 
+/*
+ * glReadPixels is the sync point for the pixels it reads: the driver has the drawable's rendering
+ * finished before it returns them, per read rather than per queue. The glFinish this path took
+ * first therefore drained every queue in the context for nothing -- the double wait the
+ * AHardwareBuffer path was added to remove (see gles_ahb_lock). Kept as a switch for a driver that
+ * tests badly: LT_READBACK_FINISH=on.
+ */
+static bool gles_readback_finish(void)
+{
+    static int on = -1;
+
+    if (on < 0) {
+        const char *v = getenv("LT_READBACK_FINISH");
+
+        on = v && (!strcmp(v, "on") || !strcmp(v, "1"));
+    }
+    return on;
+}
+
 /*
  * A locked frame row in the guest's BGRA order: @src itself, or @scratch
  * holding it byte-swapped when the platform could only render RGBA.
@@ -3172,8 +3201,23 @@ static inline const uint8_t *gles_frame_row(const uint8_t *src, uint8_t *scratch
     if (gh.ahb.rgba) {
         const uint32_t *s = (const uint32_t *)src;
         uint32_t *d = (uint32_t *)scratch;
+        uint32_t i = 0;
 
-        for (uint32_t i = 0; i < pixels; i++) {
+#if defined(__aarch64__) && defined(__ARM_NEON)
+        /* Four pixels a byte shuffle, as the Android presenter's own convert does: this runs over
+         * every pixel of every frame on a driver that refused BGRA storage for the surface. */
+        static const uint8_t swap[16] = {
+            2, 1, 0, 3, 6, 5, 4, 7, 10, 9, 8, 11, 14, 13, 12, 15,
+        };
+        uint8x16_t table = vld1q_u8(swap);
+
+        for (; i + 4 <= pixels; i += 4) {
+            uint8x16_t v = vld1q_u8((const uint8_t *)(s + i));
+
+            vst1q_u8((uint8_t *)(d + i), vqtbl1q_u8(v, table));
+        }
+#endif
+        for (; i < pixels; i++) {
             uint32_t v = s[i];
             d[i] = (v & 0xff00ff00u) | (v >> 16 & 0xffu) | (v & 0xffu) << 16;
         }
@@ -4114,7 +4158,9 @@ static int gles_present_to_surface_impl(CPUState *cpu, uint32_t base, uint32_t s
         /* Same as the panel present above: read the drawable, not whichever
          * offscreen target the guest left bound. */
         glBindFramebufferEXT(GL_FRAMEBUFFER_EXT, gh.fbo);
-        glFinish();
+        if (gles_readback_finish()) {
+            glFinish();         /* LT_READBACK_FINISH=on: the drain this path used to take */
+        }
         if (sample) {
             sample->path = 2;
         }
