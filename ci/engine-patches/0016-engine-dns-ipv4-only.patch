+/*
+ * Does this phone have an IPv6 address it could send from?
+ *
+ * netd answers an AAAA question whether or not the phone has a route for it: the address comes
+ * from the DNS server, not from the interface. iOS 6 then tries the first AAAA, waits for a
+ * connect that cannot leave the phone, and only then tries the A record -- a second or two on
+ * every page whose host publishes AAAA. QEMU's user network has the same gap: it answers with
+ * the host's IPv6, which a phone on a v4-only carrier or a VPN without v6 does not have. So an
+ * AAAA answer is only handed to the guest while a global (or unique-local) IPv6 address is up
+ * on the phone; otherwise the answer is an empty NOERROR and the guest goes straight to IPv4.
+ * Loopback and link-local (fe80::/10) do not count: neither can reach an internet host.
+ */
+static bool android_has_ipv6(void)
+{
+    static int cached = -1;
+    static int64_t checked;
+    int64_t now = g_get_real_time() / G_USEC_PER_SEC;
+
+    if (cached >= 0 && now - checked < 30) {
+        return cached;
+    }
+    cached = 0;
+    struct ifaddrs *all = NULL;
+    if (getifaddrs(&all) == 0) {
+        for (const struct ifaddrs *ifa = all; ifa; ifa = ifa->ifa_next) {
+            if (!ifa->ifa_addr || ifa->ifa_addr->sa_family != AF_INET6 ||
+                !(ifa->ifa_flags & IFF_UP) || (ifa->ifa_flags & IFF_LOOPBACK)) {
+                continue;
+            }
+            const struct sockaddr_in6 *a6 = (const struct sockaddr_in6 *)ifa->ifa_addr;
+            if (IN6_IS_ADDR_LOOPBACK(&a6->sin6_addr) || IN6_IS_ADDR_LINKLOCAL(&a6->sin6_addr)) {
+                continue;
+            }
+            if (IN6_IS_ADDR_V4MAPPED(&a6->sin6_addr)) {
+                continue;
+            }
+            cached = 1;
+            break;
+        }
+        freeifaddrs(all);
+    }
+    checked = now;
+    return cached;
+}
+
