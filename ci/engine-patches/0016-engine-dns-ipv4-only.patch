From 0cc9e4ce9e6389a08beeacb4940408f62fd00b1b Mon Sep 17 00:00:00 2001
From: Un1box <ci@un1box>
Date: Fri, 27 Nov 2026 09:36:00 +0000
Subject: [PATCH] engine: prefer IPv4 DNS resolvers on Android

---
 net/slirp-dns.c | 26 +++++++++++++++-----------
 1 file changed, 15 insertions(+), 11 deletions(-)

diff --git a/net/slirp-dns.c b/net/slirp-dns.c
index 77addfd252..4ba7391ab6 100644
--- a/net/slirp-dns.c
+++ b/net/slirp-dns.c
@@ -140,7 +140,7 @@ static void dns_add_answer(DNSJob *j, uint16_t type, const void *rdata, size_t r
 #define DNS_CACHE_ENTRIES 32
 #define DNS_CACHE_RECORDS 8
 #define DNS_CACHE_NAME 128
-#define DNS_CACHE_TTL_S 60
+#define DNS_CACHE_TTL_S 300
 #define DNS_CACHE_FAILURE_TTL_S 10
 
 typedef struct DNSCacheEntry {
@@ -201,13 +201,25 @@ static void dns_resolve_android(DNSJob *j, const char *name, uint16_t qtype)
         j->rcode = 0;
         return;
     }
+    /*
+     * No AAAA for the guest. The phone's user network is IPv4 (the boards' wifi0 netdev is
+     * created with ipv6=off): slirp's NAT66 is slower than its IPv4 path and, on a carrier or
+     * VPN whose IPv6 route is black-holed, a guest that picks the AAAA first waits for a connect
+     * that never leaves the phone before trying the A record -- one stalled site after another in
+     * Safari and Cydia. netd answers the query whether or not the phone can route it, so the
+     * filtering has to be here. An empty NOERROR makes iOS 6 go straight to IPv4.
+     */
+    if (qtype == 28) {
+        j->rcode = 0;
+        return;
+    }
     if (dns_cache_lookup(j, name, qtype)) {
         return;
     }
     DNSCacheEntry fresh;
     memset(&fresh, 0, sizeof fresh);
     struct addrinfo hints = {
-        .ai_family = qtype == 28 ? AF_INET6 : qtype == 1 ? AF_INET : AF_UNSPEC,
+        .ai_family = qtype == 1 ? AF_INET : AF_UNSPEC,
         .ai_socktype = SOCK_STREAM,
     }, *res = NULL;
     int rc = getaddrinfo(name, NULL, &hints, &res);
@@ -232,15 +244,7 @@ static void dns_resolve_android(DNSJob *j, const char *name, uint16_t qtype)
     }
     j->rcode = 0;
     for (const struct addrinfo *a = res; a; a = a->ai_next) {
-        if (a->ai_family == AF_INET6) {
-            const void *address = &((const struct sockaddr_in6 *)a->ai_addr)->sin6_addr;
-            if (fresh.records < DNS_CACHE_RECORDS) {
-                memcpy(fresh.rdata[fresh.records], address, 16);
-                fresh.lengths[fresh.records] = 16;
-                fresh.records++;
-            }
-            dns_add_answer(j, 28, address, 16);
-        } else if (a->ai_family == AF_INET) {
+        if (a->ai_family == AF_INET) {
             const void *address = &((const struct sockaddr_in *)a->ai_addr)->sin_addr;
             if (fresh.records < DNS_CACHE_RECORDS) {
                 memcpy(fresh.rdata[fresh.records], address, 4);
