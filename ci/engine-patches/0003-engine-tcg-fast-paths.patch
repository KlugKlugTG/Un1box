From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Un1box <un1box@localhost>
Date: Sun, 25 Oct 2026 18:44:18 +0000
Subject: [PATCH] tcg: the two measured fast paths on by default on Android, and huge pages for guest RAM

Both fast paths were experiments that had to be switched on by hand (LT_TB_LOOKUP_INLINE=on,
LT_IBTC_L2=on). Each was ahead in every interleaved pair measured on the phones: the inlined TB
lookup hit 6 of 6, the indirect side table +2.2% in 3 of 3, and on LT Bench the pair took icall
29.7 -> 13.4 ns and runloop 9.4 -> 8.0 us. A vCPU-bound guest -- every game on the iPod touch
4G -- pays for the lookup on every block exit, so Android now runs both by default; the same
names with "off" stay the A/B arm on any host, and the desktop is unchanged.

Guest RAM is asked for transparent huge pages: 128 MiB of guest memory is 32K host pages, and
the translated code's loads and stores are the data side of nearly every block. LT_RAM_HUGEPAGE=off
for an A/B. Where the kernel has no THP this is a no-op.

---
diff --git a/accel/tcg/tcg-all.c b/accel/tcg/tcg-all.c
index 4df4f89..fc2a3dd 100644
--- a/accel/tcg/tcg-all.c
+++ b/accel/tcg/tcg-all.c
@@ -112,9 +112,23 @@ static int tcg_init_machine(AccelState *as, MachineState *ms)
     TCGState *s = TCG_STATE(as);
     unsigned max_threads = 1;
 
+    /*
+     * Both fast paths were experiments that had to be enabled by hand. Each was ahead in every
+     * interleaved pair measured on the phones (PERFORMANCE.md: the inlined TB lookup hit 6 of 6,
+     * the indirect side table +2.2% in 3 of 3, LT Bench icall 29.7 -> 13.4 ns and runloop
+     * 9.4 -> 8.0 us), and a vCPU-bound guest -- every game on the iPod touch 4G -- pays for the
+     * lookup on every block exit. Android runs them by default now; the same names with "off"
+     * remain the A/B arm on every host, and the inlined lookup still makes the vCPU accounting
+     * use its legacy path.
+     */
+#ifdef __ANDROID__
+    const bool fast_path_default = true;
+#else
+    const bool fast_path_default = false;
+#endif
     const char *inline_lookup = getenv("LT_TB_LOOKUP_INLINE");
-    tcg_inline_tb_lookup = inline_lookup && strcmp(inline_lookup, "off") &&
-                           strcmp(inline_lookup, "0");
+    tcg_inline_tb_lookup = inline_lookup ? strcmp(inline_lookup, "off") && strcmp(inline_lookup, "0")
+                                         : fast_path_default;
     /* LT_MASKED_IRQ_FAST=off: take the BQL for every pending-interrupt check (A/B). */
     const char *masked_irq = getenv("LT_MASKED_IRQ_FAST");
     tcg_masked_irq_fast = !(masked_irq && (!strcmp(masked_irq, "off") || !strcmp(masked_irq, "0")));
@@ -124,13 +138,16 @@ static int tcg_init_machine(AccelState *as, MachineState *ms)
 
     const char *indirect_l2 = getenv("LT_IBTC_L2");
     const char *indirect_prof = getenv("LT_IBTC_L2_PROF");
-    bool l2_on = indirect_l2 && strcmp(indirect_l2, "off") &&
-                 strcmp(indirect_l2, "0");
+    bool l2_on = indirect_l2 ? strcmp(indirect_l2, "off") && strcmp(indirect_l2, "0")
+                             : fast_path_default;
     bool l2_prof = indirect_prof && strcmp(indirect_prof, "off") &&
                    strcmp(indirect_prof, "0");
     /* The generated site cache and this side table share single-vCPU rules. */
     bool single_vcpu = ms->smp.cpus == 1 && ms->smp.max_cpus == 1;
     tcg_indirect_l2_init(l2_on && single_vcpu, l2_prof && single_vcpu);
+    if (l2_on && single_vcpu) {
+        fprintf(stderr, "[tcg] indirect-l2=on\n");
+    }
 
 #ifndef CONFIG_USER_ONLY
     CPUClass *cc = CPU_CLASS(object_class_by_name(target_cpu_type()));
diff --git a/util/oslib-posix.c b/util/oslib-posix.c
index a2e1d5c..7696988 100644
--- a/util/oslib-posix.c
+++ b/util/oslib-posix.c
@@ -234,6 +234,21 @@ void *qemu_anon_ram_alloc(size_t size, uint64_t *alignment, bool shared,
         *alignment = align;
     }
 
+    /*
+     * The guest's RAM is the data side of nearly every translated access, and a 128 MiB guest is
+     * 32K host pages: the translated code's loads and stores then spend dTLB misses on memory the
+     * guest touches in every block. Ask the kernel to back the region with huge pages -- where
+     * transparent huge pages are unavailable, or the kernel only collapses on request, this is a
+     * no-op. Framebuffers and the command FIFO are not on this path.
+     */
+    if (size >= 2 * MiB) {
+        const char *huge = getenv("LT_RAM_HUGEPAGE");
+
+        if (!(huge && (!strcmp(huge, "off") || !strcmp(huge, "0")))) {
+            qemu_madvise(ptr, size, QEMU_MADV_HUGEPAGE);
+        }
+    }
+
     trace_qemu_anon_ram_alloc(size, ptr);
     return ptr;
 }
