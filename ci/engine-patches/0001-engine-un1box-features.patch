+++ b/accel/tcg/tcg-all.c
@@ -113,9 +113,23 @@ static int tcg_init_machine(AccelState *as, MachineState *ms)
     TCGState *s = TCG_STATE(as);
     unsigned max_threads = 1;
 
+    /*
