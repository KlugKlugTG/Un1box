 {
     if (gles_guest_rw_hook) {
diff --git a/hw/arm/host-camera.c b/hw/arm/host-camera.c
new file mode 100644
index 0000000000..84cc328bd1
--- /dev/null
+++ b/hw/arm/host-camera.c
@@ -0,0 +1,194 @@
+/*
+ * The phone's camera into the emulated device: the mailbox the app fills and the
+ * ISP empties. See include/hw/arm/host-camera.h for the contract.
+ *
+ * The size limits live here because the two sides disagree about what a frame
+ * is: the app knows the phone's preview sizes (640x480 up to 1280x960), the
+ * guest asks the ISP for whatever mode its driver picked. A frame outside these
+ * bounds is a bug in the caller, and taking it would mean the ISP scaling from a
+ * buffer that is not what it claims -- so it is refused, not truncated.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "hw/arm/host-camera.h"
+#include <pthread.h>
+
+#define HOST_CAMERA_MIN_SIDE    16
+#define HOST_CAMERA_MAX_SIDE    4096
+#define HOST_CAMERA_MAX_FRAME   (HOST_CAMERA_MAX_SIDE * HOST_CAMERA_MAX_SIDE * 3 / 2)
+
+/* A statically initialised lock, because the app may write before any device
+ * exists: there is no point at which it would be safe to initialise one. */
+static pthread_mutex_t camera_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static bool attached;               /* an ISP has been created: frames have a destination */
+static int source = HOST_CAMERA_BACK;   /* which camera the picture came from */
+static int active = HOST_CAMERA_BACK;   /* which camera the guest last named */
+
+static uint8_t *mailbox;            /* the newest frame the app wrote */
+static size_t mailbox_size;
+static unsigned mailbox_width, mailbox_height;
+static uint64_t mailbox_generation;
+static bool unread;                 /* written since the ISP last copied it up */
+
+static uint8_t *snapshot;           /* the ISP's own copy, drawn while it scales */
+static size_t snapshot_size;
+static unsigned snapshot_width, snapshot_height;
+static int snapshot_sensor = HOST_CAMERA_BACK;
+static bool snapshot_valid;
+static uint64_t snapshot_generation;
+
+static uint64_t pushed, taken, replaced;
+
+void host_camera_attach(void)
+{
+    pthread_mutex_lock(&camera_lock);
+    attached = true;
+    g_free(mailbox);
+    mailbox = NULL;
+    mailbox_size = 0;
+    mailbox_width = mailbox_height = 0;
+    mailbox_generation++;
+    unread = false;
+    source = HOST_CAMERA_BACK;
+    active = HOST_CAMERA_BACK;
+    pushed = taken = replaced = 0;
+    pthread_mutex_unlock(&camera_lock);
+}
+
+int host_camera_write(int sensor, const void *nv12, unsigned width, unsigned height)
+{
+    size_t need;
+    uint8_t *copy;
+
+    if (!nv12 || width < HOST_CAMERA_MIN_SIDE || height < HOST_CAMERA_MIN_SIDE ||
+        width > HOST_CAMERA_MAX_SIDE || height > HOST_CAMERA_MAX_SIDE ||
+        (width & 1) || (height & 1)) {
+        return -1;
+    }
+    need = (size_t)width * height * 3 / 2;
+    if (need > HOST_CAMERA_MAX_FRAME) {
+        return -1;
+    }
+    /* Copied outside the lock: the caller's buffer is half a megabyte and the
+     * ISP's own thread must not wait for a copy it is not making. */
+    copy = g_malloc(need);
+    memcpy(copy, nv12, need);
+
+    pthread_mutex_lock(&camera_lock);
+    if (!attached) {
+        pthread_mutex_unlock(&camera_lock);
+        g_free(copy);
+        return 0;
+    }
+    if (unread) {
+        /* An unread frame is replaced, not queued: this is a viewfinder. */
+        replaced++;
+    }
+    g_free(mailbox);
+    mailbox = copy;
+    mailbox_size = need;
+    mailbox_width = width;
+    mailbox_height = height;
+    mailbox_generation++;
+    unread = true;
+    source = sensor == HOST_CAMERA_FRONT ? HOST_CAMERA_FRONT : HOST_CAMERA_BACK;
+    pushed++;
+    pthread_mutex_unlock(&camera_lock);
+    return 1;
+}
+
+void host_camera_snapshot(HostCameraFrame *out)
+{
+    if (!out) {
+        return;
+    }
+    out->data = NULL;
+    out->size = 0;
+    out->width = out->height = 0;
+    out->sensor = HOST_CAMERA_BACK;
+
+    pthread_mutex_lock(&camera_lock);
+    if (snapshot_generation != mailbox_generation) {
+        snapshot_generation = mailbox_generation;
+        if (!mailbox) {
+            snapshot_valid = false;     /* flushed: back to the pattern */
+        } else {
+            if (snapshot_size < mailbox_size) {
+                snapshot = g_realloc(snapshot, mailbox_size);
+                snapshot_size = mailbox_size;
+            }
+            memcpy(snapshot, mailbox, mailbox_size);
+            snapshot_width = mailbox_width;
+            snapshot_height = mailbox_height;
+            snapshot_sensor = source;
+            snapshot_valid = true;
+            unread = false;
+            taken++;
+        }
+    }
+    if (snapshot_valid) {
+        out->data = snapshot;
+        out->size = (size_t)snapshot_width * snapshot_height * 3 / 2;
+        out->width = snapshot_width;
+        out->height = snapshot_height;
+        out->sensor = snapshot_sensor;
+    }
+    pthread_mutex_unlock(&camera_lock);
+}
+
+void host_camera_select(int sensor)
+{
+    if (sensor != HOST_CAMERA_BACK && sensor != HOST_CAMERA_FRONT) {
+        return;
+    }
+    pthread_mutex_lock(&camera_lock);
+    active = sensor;
+    pthread_mutex_unlock(&camera_lock);
+}
+
+int host_camera_active(void)
+{
+    int sensor;
+
+    pthread_mutex_lock(&camera_lock);
+    sensor = active;
+    pthread_mutex_unlock(&camera_lock);
+    return sensor;
+}
+
+void host_camera_counts(uint64_t *pushed_out, uint64_t *taken_out, uint64_t *replaced_out,
+                        unsigned *width, unsigned *height)
+{
+    pthread_mutex_lock(&camera_lock);
+    if (pushed_out) {
+        *pushed_out = pushed;
+    }
+    if (taken_out) {
+        *taken_out = taken;
+    }
+    if (replaced_out) {
+        *replaced_out = replaced;
+    }
+    if (width) {
+        *width = snapshot_valid ? snapshot_width : 0;
+    }
+    if (height) {
+        *height = snapshot_valid ? snapshot_height : 0;
+    }
+    pthread_mutex_unlock(&camera_lock);
+}
+
+void host_camera_flush(void)
+{
+    pthread_mutex_lock(&camera_lock);
+    g_free(mailbox);
+    mailbox = NULL;
+    mailbox_size = 0;
+    mailbox_width = mailbox_height = 0;
+    mailbox_generation++;
+    unread = false;
+    pushed = taken = replaced = 0;
+    pthread_mutex_unlock(&camera_lock);
+}
diff --git a/hw/arm/host-mic.c b/hw/arm/host-mic.c
new file mode 100644
index 0000000000..97386ad49e
--- /dev/null
+++ b/hw/arm/host-mic.c
@@ -0,0 +1,150 @@
+/*
+ * The frontend's microphone: a bounded ring between the host app and an audio
+ * device's capture port. See include/hw/arm/host-mic.h for the shape of the
+ * path and why the phone's engine needs it (`driver=none` has no input voice).
+ *
+ * Rates. The app records at HOST_MIC_RATE; a port reads at its own frame rate.
+ * A 16.16 accumulator picks the source frame for each output frame, nearest
+ * neighbour: an exact pass-through at 44.1 kHz, and pitch-correct (aliased
+ * rather than filtered) at any other rate. Linear interpolation would need the
+ * ring to hold one more frame than the reader has consumed, which the
+ * single-frame interface here cannot express; the guest's own HAL resamples
+ * after this point anyway.
+ *
+ * Locking. The app pushes from its recorder thread and the port reads on the
+ * vCPU thread under the BQL, so the ring has its own mutex. Neither side ever
+ * waits for the other: a full ring drops the app's block, an empty one hands
+ * the port silence.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "qemu/bswap.h"        /* stw_le_p: osdep does not pull it in (system/memory.h does) */
+#include "hw/arm/host-mic.h"
+
+#include <pthread.h>
+
+/* The app has stopped: after this much quiet the port gets silence instead of
+ * the ring's tail, so a stopped recording does not loop the last 93 ms. */
+#define HOST_MIC_STALE_US 250000
+
+static pthread_mutex_t host_mic_lock = PTHREAD_MUTEX_INITIALIZER;
+static int16_t host_mic_ring[HOST_MIC_FRAMES][2];
+static uint32_t host_mic_head, host_mic_level;
+static unsigned host_mic_rate = HOST_MIC_RATE;
+/* Source frames consumed per output frame, 16.16. */
+static uint32_t host_mic_step = 1 << 16;
+static uint32_t host_mic_acc;
+static int64_t host_mic_last_push_us = -1;
+static uint32_t host_mic_capturing;
+static uint64_t host_mic_pushed, host_mic_dropped;
+
+static void host_mic_reset_locked(void)
+{
+    host_mic_head = host_mic_level = 0;
+    host_mic_acc = 0;
+    host_mic_last_push_us = -1;
+}
+
+uint32_t host_mic_push(const void *frames, size_t bytes)
+{
+    const int16_t *in = frames;
+    uint32_t count, taken = 0;
+
+    if (!in || bytes < 4) {
+        return 0;
+    }
+    count = bytes / 4;
+    pthread_mutex_lock(&host_mic_lock);
+    host_mic_last_push_us = g_get_monotonic_time();
+    /* The guest caught up: the frame it reads next is this one, not the
+     * fractional remainder of a position from before the gap. */
+    if (!host_mic_level) {
+        host_mic_acc = 0;
+    }
+    while (taken < count && host_mic_level < HOST_MIC_FRAMES) {
+        uint32_t slot = (host_mic_head + host_mic_level) % HOST_MIC_FRAMES;
+
+        host_mic_ring[slot][0] = in[2 * taken];
+        host_mic_ring[slot][1] = in[2 * taken + 1];
+        host_mic_level++;
+        taken++;
+    }
+    host_mic_pushed += taken;
+    host_mic_dropped += count - taken;
+    pthread_mutex_unlock(&host_mic_lock);
+    return taken;
+}
+
+void host_mic_flush(void)
+{
+    pthread_mutex_lock(&host_mic_lock);
+    host_mic_reset_locked();
+    host_mic_capturing = 0;
+    pthread_mutex_unlock(&host_mic_lock);
+}
+
+void host_mic_set_rate(unsigned rate)
+{
+    if (rate < 8000 || rate > 192000) {
+        rate = HOST_MIC_RATE;
+    }
+    pthread_mutex_lock(&host_mic_lock);
+    host_mic_capturing = 1;
+    if (rate != host_mic_rate) {
+        host_mic_rate = rate;
+        host_mic_step = (uint32_t)(((uint64_t)HOST_MIC_RATE << 16) / rate);
+        if (!host_mic_step) {
+            host_mic_step = 1 << 16;
+        }
+        host_mic_acc = 0;
+    }
+    pthread_mutex_unlock(&host_mic_lock);
+}
+
+bool host_mic_read_frame(uint8_t out[4])
+{
+    int16_t frame[2];
+    bool have = false;
+
+    pthread_mutex_lock(&host_mic_lock);
+    if (host_mic_last_push_us >= 0 &&
+        g_get_monotonic_time() - host_mic_last_push_us > HOST_MIC_STALE_US) {
+        host_mic_reset_locked();
+    }
+    if (host_mic_level) {
+        frame[0] = host_mic_ring[host_mic_head][0];
+        frame[1] = host_mic_ring[host_mic_head][1];
+        /* This frame is the one at the reader's position; the accumulator then decides how far
+         * the position moves for the next one. Consuming before handing out would shift the whole
+         * recording by a frame, and re-reading the head after consuming would double it. */
+        host_mic_acc += host_mic_step;
+        while (host_mic_acc >= (uint32_t)1 << 16 && host_mic_level) {
+            host_mic_acc -= (uint32_t)1 << 16;
+            host_mic_head = (host_mic_head + 1) % HOST_MIC_FRAMES;
+            host_mic_level--;
+        }
+        have = true;
+    }
+    pthread_mutex_unlock(&host_mic_lock);
+    if (!have) {
+        return false;
+    }
+    stw_le_p(out, frame[0]);
+    stw_le_p(out + 2, frame[1]);
+    return true;
+}
+
+void host_mic_state(HostMicState *out)
+{
+    if (!out) {
+        return;
+    }
+    pthread_mutex_lock(&host_mic_lock);
+    out->rate = host_mic_capturing ? host_mic_rate : 0;
+    out->queued = host_mic_level;
+    out->capturing = host_mic_capturing;
+    out->pushed = host_mic_pushed;
+    out->dropped = host_mic_dropped;
+    pthread_mutex_unlock(&host_mic_lock);
+}
