diff --git a/tests/unit/test-s5l8930-isp-camera.c b/tests/unit/test-s5l8930-isp-camera.c
new file mode 100644
index 0000000000..f65917914e
--- /dev/null
+++ b/tests/unit/test-s5l8930-isp-camera.c
@@ -0,0 +1,51 @@
+/*
+ * Focused tests for the host-camera conversion helpers used by s5l8930_isp.c.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include <glib.h>
+#include "hw/arm/s5l8930-isp-camera.h"
+
+static void test_nv12_passthrough(void)
+{
+    const uint8_t input[] = { 16, 32, 48, 64, 128, 192 };
+    uint8_t output[sizeof(input)] = { 0 };
+
+    s5l8930_isp_camera_convert(input, 2, 2, output, 2, 2, true);
+    g_assert_cmpmem(output, sizeof(output), input, sizeof(input));
+}
+
+static void test_nv12_to_yuyv(void)
+{
+    const uint8_t input[] = { 16, 32, 48, 64, 128, 192 };
+    const uint8_t expected[] = { 16, 128, 32, 192, 48, 128, 64, 192 };
+    uint8_t output[sizeof(expected)] = { 0 };
+
+    s5l8930_isp_camera_convert(input, 2, 2, output, 2, 2, false);
+    g_assert_cmpmem(output, sizeof(output), expected, sizeof(expected));
+}
+
+static void test_scale_nearest(void)
+{
+    const uint8_t input[] = { 10, 20, 30, 40, 50, 60 };
+    const uint8_t expected[] = {
+        10, 10, 20, 20,
+        10, 10, 20, 20,
+        30, 30, 40, 40,
+        30, 30, 40, 40,
+        50, 60, 50, 60,
+        50, 60, 50, 60,
+    };
+    uint8_t output[sizeof(expected)] = { 0 };
+
+    s5l8930_isp_camera_convert(input, 2, 2, output, 4, 4, true);
+    g_assert_cmpmem(output, sizeof(output), expected, sizeof(expected));
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_func("/s5l8930-isp-camera/nv12-passthrough", test_nv12_passthrough);
+    g_test_add_func("/s5l8930-isp-camera/nv12-to-yuyv", test_nv12_to_yuyv);
+    g_test_add_func("/s5l8930-isp-camera/scale-nearest", test_scale_nearest);
+    return g_test_run();
+}
diff --git a/util/oslib-posix.c b/util/oslib-posix.c
index 5d17cf533d..e57af2955c 100644
--- a/util/oslib-posix.c
+++ b/util/oslib-posix.c
@@ -238,6 +238,21 @@ void *qemu_anon_ram_alloc(size_t size, uint64_t *alignment, bool shared,
         *alignment = align;
     }
 
+    /*
+     * The guest's RAM is the data side of nearly every translated access, and a 128 MiB guest is
+     * 32K host pages: the translated code's loads and stores then spend dTLB misses on memory the
+     * guest touches in every block. Ask the kernel to back the region with huge pages -- where
+     * transparent huge pages are unavailable, or the kernel only collapses on request, this is a
+     * no-op. Framebuffers and the command FIFO are not on this path.
+     */
+    if (size >= 2 * MiB) {
+        const char *huge = getenv("LT_RAM_HUGEPAGE");
+
+        if (!(huge && (!strcmp(huge, "off") || !strcmp(huge, "0")))) {
+            qemu_madvise(ptr, size, QEMU_MADV_HUGEPAGE);
+        }
+    }
+
     trace_qemu_anon_ram_alloc(size, ptr);
     return ptr;
 }
