diff --git a/include/hw/arm/host-camera.h b/include/hw/arm/host-camera.h
new file mode 100644
index 0000000000..e21aa204ac
--- /dev/null
+++ b/include/hw/arm/host-camera.h
@@ -0,0 +1,78 @@
+/*
+ * The phone's camera, as the emulated device's camera sensor.
+ *
+ * The A4's camera ISP decides when a frame happens and where it goes; what it
+ * has never had is a picture. This is that picture: one mailbox the app fills
+ * with the phone's own frames and the ISP empties on its next frame.
+ *
+ * It is deliberately not a queue and not a sensor model. The guest drives one
+ * camera at a time and asks the ISP for frames whether or not anyone is
+ * looking, so what it needs is the newest picture, at whatever size the phone
+ * produced, and the ISP is the one that scales it to the mode the guest asked
+ * for. An old frame is worth nothing: a push over a frame nobody drew replaces
+ * it, which is why a slow guest costs a drop and never a delay.
+ *
+ * Nothing in here knows about QEMU or the ISP: it is a hand-off between threads
+ * (the app's camera thread writes, the emulator's vCPU thread reads), and the
+ * lock is held only for the copy.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef HW_ARM_HOST_CAMERA_H
+#define HW_ARM_HOST_CAMERA_H
+
+#include "qemu/osdep.h"
+
+/* Which of the phone's cameras a frame came from: the two the A4 boards carry. */
+#define HOST_CAMERA_BACK    0       /* MIPI, the one on the back */
+#define HOST_CAMERA_FRONT   1       /* SMIA, the one above the screen */
+
+/* One frame, as the ISP sees it: tightly packed NV12, valid until the next snapshot. */
+typedef struct HostCameraFrame {
+    const uint8_t *data;            /* NULL when there is nothing to draw */
+    size_t size;
+    unsigned width, height;
+    int sensor;                     /* which of the phone's cameras it came from */
+} HostCameraFrame;
+
+/*
+ * The ISP exists now. Until this is called a pushed frame is dropped: there is
+ * nothing that could ever draw it, and a host without a camera (a desktop, a
+ * check boot) must not appear to have one.
+ */
+void host_camera_attach(void);
+
+/*
+ * The app hands over one frame, NV12 (luma, then interleaved chroma, no
+ * padding), of width x height. The buffer is copied, so the caller keeps its
+ * own. `sensor` is only recorded, so the app can say which camera the picture
+ * came from. Returns 1 when accepted, 0 when no ISP is there to draw it, and -1
+ * for something that is not a frame: the app treats that as its own mistake,
+ * not as something to retry.
+ */
+int host_camera_write(int sensor, const void *nv12, unsigned width, unsigned height);
+
+/*
+ * Once per ISP frame, before drawing: copy the newest mailbox frame if the app
+ * has written one since the last call. `*out` describes it, or has a NULL data
+ * pointer when there is nothing to draw -- before the first write and after a
+ * flush, which is when the ISP's own test pattern shows.
+ */
+void host_camera_snapshot(HostCameraFrame *out);
+
+/* Which camera the guest's driver last named, for the app's own diagnosis. */
+void host_camera_select(int sensor);
+int host_camera_active(void);
+
+/*
+ * Counters for the app's diagnosis, cheap enough to read every half second:
+ * frames written, frames the ISP copied up to draw, frames replaced before
+ * anything drew them, and the size of the picture being held.
+ */
+void host_camera_counts(uint64_t *pushed, uint64_t *taken, uint64_t *replaced,
+                        unsigned *width, unsigned *height);
+
+/* Forget the held frame: the pattern resumes until the next write. */
+void host_camera_flush(void);
+
+#endif
diff --git a/include/hw/arm/host-mic.h b/include/hw/arm/host-mic.h
new file mode 100644
index 0000000000..f146165ed8
--- /dev/null
+++ b/include/hw/arm/host-mic.h
@@ -0,0 +1,54 @@
+/*
+ * The frontend's microphone, as an audio device's capture port sees it.
+ *
+ * The engine on a phone runs its audio backend as `driver=none`, so a capture
+ * port's input voice never opens and a recording app in the guest hears
+ * silence. This is the input counterpart of the output capture tap the portable
+ * library installs: the frontend pushes the frames its microphone recorded and
+ * a port hands them to the guest as if an input voice had queued them.
+ *
+ *   host app -> host_mic_push() -> ring -> host_mic_read_frame() -> RX FIFO
+ *
+ * The capture port asks this ring BEFORE its own input voice: the phone's
+ * engine has no real input voice, but `driver=none`'s silence-producing one
+ * opens anyway (audio/noaudio.c), so a fallback behind it would never run.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef HW_ARM_HOST_MIC_H
+#define HW_ARM_HOST_MIC_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+/* The rate the frontend records at: what iOS uses, and what AudioRecord opens
+ * at on every Android device. A capture port at another rate is resampled. */
+#define HOST_MIC_RATE 44100
+
+/* Frames of stereo S16 the ring holds: 93 ms at 44.1 kHz, enough to cover the
+ * app's block (23 ms) and a burst on the guest side, and small enough that a
+ * guest which stops reading costs a fraction of a second of audio. */
+#define HOST_MIC_FRAMES 4096
+
+typedef struct HostMicState {
+    uint32_t rate;          /* the capture port's rate; 0 before one starts */
+    uint32_t queued;        /* frames waiting for the guest */
+    uint32_t capturing;     /* a port has asked for input since the last flush */
+    uint64_t pushed;        /* frames the frontend handed over */
+    uint64_t dropped;       /* frames the ring had no room for */
+} HostMicState;
+
+/* Frames the frontend recorded: interleaved stereo S16, HOST_MIC_RATE, `bytes`
+ * a multiple of 4. Returns the frames accepted; the rest did not fit. */
+uint32_t host_mic_push(const void *frames, size_t bytes);
+/* Forget everything: a port started, stopped, or the app stopped recording. */
+void host_mic_flush(void);
+/* The rate the capture port reads at, from its own configuration. */
+void host_mic_set_rate(unsigned rate);
+/* One stereo S16 frame at the port's rate, little-endian, as the RX FIFO holds
+ * it. False when the app has nothing for the guest (which then reads silence). */
+bool host_mic_read_frame(uint8_t out[4]);
+void host_mic_state(HostMicState *out);
+
+#endif
diff --git a/include/hw/arm/s5l8930-isp-camera.h b/include/hw/arm/s5l8930-isp-camera.h
new file mode 100644
index 0000000000..66acbca6d5
--- /dev/null
+++ b/include/hw/arm/s5l8930-isp-camera.h
@@ -0,0 +1,79 @@
+/*
+ * Pure conversion helpers for the A4 ISP's host-camera input path.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef HW_ARM_S5L8930_ISP_CAMERA_H
+#define HW_ARM_S5L8930_ISP_CAMERA_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+static inline unsigned s5l8930_isp_scale_nearest(unsigned source, unsigned destination,
+                                                  unsigned position)
+{
+    unsigned value = (unsigned)(((uint64_t)(2 * position + 1) * source) /
+                                (2 * destination));
+
+    return value < source ? value : source - 1;
+}
+
+/* Source and destination are tightly packed NV12 and packed Y0 Cb Y1 Cr
+ * ('yuvs') respectively. All dimensions are positive, even and <= 4096. */
+static inline void s5l8930_isp_camera_convert(const uint8_t *source,
+                                              unsigned source_width,
+                                              unsigned source_height,
+                                              uint8_t *destination,
+                                              unsigned width,
+                                              unsigned height,
+                                              bool nv12)
+{
+    const uint8_t *source_uv = source + (size_t)source_width * source_height;
+
+    if (nv12) {
+        for (unsigned y = 0; y < height; y++) {
+            unsigned sy = s5l8930_isp_scale_nearest(source_height, height, y);
+
+            for (unsigned x = 0; x < width; x++) {
+                unsigned sx = s5l8930_isp_scale_nearest(source_width, width, x);
+
+                destination[(size_t)y * width + x] = source[(size_t)sy * source_width + sx];
+            }
+        }
+        uint8_t *destination_uv = destination + (size_t)width * height;
+
+        for (unsigned y = 0; y < height / 2; y++) {
+            unsigned sy = s5l8930_isp_scale_nearest(source_height / 2, height / 2, y);
+
+            for (unsigned x = 0; x < width; x += 2) {
+                unsigned sx = 2 * s5l8930_isp_scale_nearest(source_width / 2, width / 2, x / 2);
+                size_t src = (size_t)sy * source_width + sx;
+                size_t dst = (size_t)y * width + x;
+
+                destination_uv[dst] = source_uv[src];
+                destination_uv[dst + 1] = source_uv[src + 1];
+            }
+        }
+    } else {
+        for (unsigned y = 0; y < height; y++) {
+            unsigned sy = s5l8930_isp_scale_nearest(source_height, height, y);
+            unsigned cy = s5l8930_isp_scale_nearest(source_height / 2, height, y);
+
+            for (unsigned x = 0; x < width; x += 2) {
+                unsigned sx0 = s5l8930_isp_scale_nearest(source_width, width, x);
+                unsigned sx1 = s5l8930_isp_scale_nearest(source_width, width, x + 1);
+                unsigned cx = 2 * s5l8930_isp_scale_nearest(source_width / 2, width / 2, x / 2);
+                size_t src_uv = (size_t)cy * source_width + cx;
+                size_t src_y = (size_t)sy * source_width;
+                size_t dst = ((size_t)y * width + x) * 2;
+
+                destination[dst] = source[src_y + sx0];
+                destination[dst + 1] = source_uv[src_uv];
+                destination[dst + 2] = source[src_y + sx1];
+                destination[dst + 3] = source_uv[src_uv + 1];
+            }
+        }
+    }
+}
+
+#endif
