+    if (rate) {
+        *rate = state.rate;
+    }
+    if (queued) {
+        *queued = state.queued;
+    }
+    if (pushed) {
+        *pushed = state.pushed;
+    }
+    if (dropped) {
+        *dropped = state.dropped;
+    }
+    return state.capturing ? 1 : 0;
