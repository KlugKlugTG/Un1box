 contrib/macos-app/qemu-macos-extras.h |  14 ++-
 hw/arm/host-mic.c                     | 150 ++++++++++++++++++++++++++
 hw/arm/meson.build                    |   2 +-
 hw/arm/s5l8930_i2s.c                  |  39 +++++--
 include/hw/arm/host-mic.h             |  54 ++++++++++
 6 files changed, 293 insertions(+), 8 deletions(-)
