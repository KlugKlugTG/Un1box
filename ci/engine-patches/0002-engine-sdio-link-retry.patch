diff --git a/hw/arm/bcm_fullmac.c b/hw/arm/bcm_fullmac.c
index b6c062c8ca..8c5dcdb60f 100644
--- a/hw/arm/bcm_fullmac.c
+++ b/hw/arm/bcm_fullmac.c
@@ -141,6 +141,15 @@ static void sdpcm_send_event(BCMFullmacState *s, uint32_t event_type,
  * the "bssid" property (s->bssid); this is its default. */
 const uint8_t bcm_fullmac_default_bssid[6] = {0x02, 0x00, 0x5e,
                                               0x10, 0x00, 0x01};
+/* How long after a join the guest is given to use it, and how many times the association events
+ * are repeated. iOS 5 is why this exists: its first wifid scan lands about when the auto-join timer
+ * does, and a join that arrives in the middle of it is dropped -- the driver loses it, the model
+ * believes itself associated, and the guest never gets a link or a lease (an iPad 1 on 5.x had no
+ * network while iOS 6 and 7.1.2 were fine). A guest that took the link says so within a second: its
+ * DHCP request is the first frame it hands the dongle. */
+#define BCM_LINK_CHECK_NS (4 * NANOSECONDS_PER_SECOND)
+#define BCM_LINK_RETRIES_MAX 4
+
 #define FAKE_SSID "qemu-ios"
 
 /* Describe the network the model claims to be on, open and on channel 6. */
@@ -303,6 +312,11 @@ static void sdio_send_assoc_events(BCMFullmacState *s)
     sdpcm_send_event(s, WLC_E_ASSOC, 0, 0);
     sdpcm_send_event(s, WLC_E_SET_SSID, 0, 0);
     sdpcm_send_event(s, WLC_E_LINK, 0, WLC_EVENT_MSG_LINK);
+    /* Look in a few seconds at whether the guest used the link (bcm_fullmac_link_check). */
+    s->link_frames = s->guest_frames;
+    if (s->link_timer) {
+        timer_mod(s->link_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + BCM_LINK_CHECK_NS);
+    }
 }
 
 /*
@@ -332,6 +346,7 @@ static void sdio_handle_set_ssid(BCMFullmacState *s, const uint8_t *payload,
     }
 
     trace_sdio("[SDIO] WLC_SET_SSID '%s': associating\n", ssid);
+    s->link_retries = 0;   /* the driver is asking again: watch this join from the start */
     sdio_send_assoc_events(s);
 }
 
@@ -385,6 +400,7 @@ static void sdio_arm_autojoin(BCMFullmacState *s)
     if (s->associated || !s->join_timer) {
         return;
     }
+    s->link_retries = 0;   /* a new arming (the host's interface came up): a new budget */
     if (v && strtod(v, NULL) > 0) {
         delay = strtod(v, NULL);
     }
@@ -392,6 +408,35 @@ static void sdio_arm_autojoin(BCMFullmacState *s)
                                  (int64_t)(delay * NANOSECONDS_PER_SECOND));
 }
 
+/*
+ * A join the guest never took. The events above are what a dongle reports, but the driver can be
+ * busy with its own work when they arrive, and a join reported during a scan is lost for good, with
+ * the model believing itself associated and nothing ever repeating it. The guest's own traffic is
+ * the proof that a link is real -- DHCP leaves within a second of one the driver accepted -- so a
+ * join with no frame from the guest after it is sent again, a few times, and only while no scan is
+ * outstanding (joining mid-scan is what the driver drops in the first place).
+ */
+static void bcm_fullmac_link_check(void *opaque)
+{
+    BCMFullmacState *s = (BCMFullmacState *)opaque;
+
+    if (!s->associated || s->guest_frames != s->link_frames) {
+        return;   /* not associated, or the guest is using the link: nothing to repair */
+    }
+    if (!s->iscan_reported) {
+        trace_sdio("[SDIO] the guest has not used the link, and a scan is outstanding\n");
+        timer_mod(s->link_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + 2 * NANOSECONDS_PER_SECOND);
+        return;
+    }
+    if (s->link_retries >= BCM_LINK_RETRIES_MAX) {
+        trace_sdio("[SDIO] the guest never used the link; leaving it alone\n");
+        return;
+    }
+    s->link_retries++;
+    trace_sdio("[SDIO] the guest has not used the link: associating again (%u)\n", s->link_retries);
+    sdio_send_assoc_events(s);
+}
+
 /*
  * How long this build's CDC header is, latched from the request.
  *
@@ -749,6 +794,9 @@ void bcm_fullmac_tx_data(BCMFullmacState *s, const uint8_t *payload,
         hexdump_frame("guest frame", payload + chosen, len - chosen);
     }
 
+    /* The guest is talking: the link check reads this. Counted even with no backend, because the
+     * frame proves the driver came up on the join either way. */
+    s->guest_frames++;
     if (!s->nic) {
         return;
     }
@@ -819,6 +867,7 @@ void bcm_fullmac_init(BCMFullmacState *s, BCMFullmacSend send,
     memcpy(s->country, "US", 3);
     s->scan_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, sdio_scan_complete, s);
     s->join_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, sdio_autojoin, s);
+    s->link_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, bcm_fullmac_link_check, s);
     bcm_fullmac_reset(s);
 }
 
@@ -835,6 +884,8 @@ void bcm_fullmac_reset(BCMFullmacState *s)
     s->toe = s->toe_ol = 0;
     s->fws_tlv = 0;
     s->tx_log = s->host_rx_log = 0;
+    timer_del(s->link_timer);
+    s->link_retries = s->guest_frames = s->link_frames = 0;
 }
 
 void bcm_fullmac_cleanup(BCMFullmacState *s)
