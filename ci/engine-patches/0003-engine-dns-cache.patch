+            dns_add_answer(j, 28, address, 16);
         } else if (a->ai_family == AF_INET) {
-            dns_add_answer(j, 1, &((const struct sockaddr_in *)a->ai_addr)->sin_addr, 4);
+            const void *address = &((const struct sockaddr_in *)a->ai_addr)->sin_addr;
+            if (fresh.records < DNS_CACHE_RECORDS) {
+                memcpy(fresh.rdata[fresh.records], address, 4);
+                fresh.lengths[fresh.records] = 4;
+                fresh.records++;
+            }
+            dns_add_answer(j, 1, address, 4);
         }
     }
     freeaddrinfo(res);
+    dns_cache_store(name, qtype, &fresh);
 }
