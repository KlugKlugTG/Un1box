+static void gles_es2_attr_enable(unsigned index, GLESArray *a, bool enabled)
+{
+    if (!gles_array_cache || a->host_enabled != enabled) {
+        if (enabled) {
+            glEnableVertexAttribArray(index);
+        } else {
+            glDisableVertexAttribArray(index);
+        }
+        a->host_enabled = enabled;
+        if (gles_prof) gh.array_enables++;
+    }
+}
+
+static void gles_widen_fixed_or_byte(GLESArray *a, const uint8_t *base,
+                                     size_t vbo_off, uint32_t count,
+                                     uint32_t stride, GLenum type)
+{
+    size_t n = (size_t)count * a->size;
+
+    if (a->vbo && a->fbuf_vbo == a->vbo &&
+        a->fbuf_vbo_gen == a->vbo->generation && a->fbuf_off == vbo_off &&
+        a->fbuf_verts == count && a->fbuf_stride == stride &&
+        a->fbuf_size == a->size && a->fbuf_type == type && n <= a->fbuf_count) {
+        return;
+    }
+    if (n > a->fbuf_count) {
+        a->fbuf = g_realloc(a->fbuf, n * sizeof(float));
+        a->fbuf_count = n;
+    }
+    if (type == GLES_FIXED && stride == a->size * 4) {
+        size_t i = 0;
+#if defined(__aarch64__) && defined(__ARM_NEON)
+        for (; i + 4 <= n; i += 4) {
+            int32x4_t raw = vld1q_s32((const int32_t *)(base + i * 4));
+            vst1q_f32(&a->fbuf[i], vcvtq_n_f32_s32(raw, 16));
+        }
+#endif
+        for (; i < n; i++) {
+            a->fbuf[i] = (float)ldl_le_p(base + i * 4) * (1.0f / 65536.0f);
+        }
+    } else if (type == GLES_FIXED) {
+        for (uint32_t row = 0; row < count; row++) {
+            const uint8_t *src = base + (size_t)stride * row;
+            for (uint32_t c = 0; c < a->size; c++) {
+                a->fbuf[(size_t)row * a->size + c] =
+                    (float)ldl_le_p(src + c * 4) * (1.0f / 65536.0f);
+            }
+        }
+    } else {
+        for (uint32_t row = 0; row < count; row++) {
+            const uint8_t *src = base + (size_t)stride * row;
+            for (uint32_t c = 0; c < a->size; c++) {
+                /* GL_BYTE positions are used unscaled, not normalized. */
+                a->fbuf[(size_t)row * a->size + c] =
+                    (float)((const int8_t *)src)[c];
+            }
+        }
+    }
+    if (a->vbo) {
+        a->fbuf_vbo = a->vbo;
+        a->fbuf_vbo_gen = a->vbo->generation;
+        a->fbuf_off = vbo_off;
+        a->fbuf_verts = count;
+        a->fbuf_stride = stride;
+        a->fbuf_size = a->size;
+        a->fbuf_type = type;
+    } else {
+        a->fbuf_vbo = NULL;
+    }
+}
