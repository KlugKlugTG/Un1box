+static void gles_interleaved_consider(const GLESArray *b, uint32_t ptr,
+                                      uint32_t stride, uint32_t first,
+                                      uint32_t count, uint64_t *span_lo,
+                                      uint64_t *span_hi)
+{
+    uint32_t b_esz, b_stride, lo_ptr, hi_ptr;
+    uint64_t b_want, b_end;
+
+    if (!b->enabled || b->vbo || !b->ptr) {
+        return;
+    }
+    b_esz = gles_type_size(b->type) * b->size;
+    if (!b_esz) {
+        return;
+    }
+    b_stride = b->stride ? b->stride : b_esz;
+    if (b_stride != stride) {
+        return;
+    }
+    lo_ptr = MIN(ptr, b->ptr);
+    hi_ptr = MAX(ptr, b->ptr);
+    if (hi_ptr - lo_ptr >= stride) {
+        return;
+    }
+    b_want = (uint64_t)b->ptr + (uint64_t)stride * first;
+    b_end = b_want + (uint64_t)stride * (count - 1) + b_esz;
+    if (b_want < *span_lo) {
+        *span_lo = b_want;
+    }
+    if (b_end > *span_hi) {
+        *span_hi = b_end;
+    }
+}
+
+/*
+ * Expand [want, want + need) to the convex hull of enabled client arrays in
+ * this draw that share `stride` and start within `stride` bytes of `a->ptr`.
+ * Without this, `pos` at offset 0 stops at `stride * (count - 1) + pos_esz`,
+ * leaving the last vertex's `uv`/`color` bytes outside the fetched range so
+ * later interleaved attributes miss the pool on every draw.
+ */
+static void gles_interleaved_span(const GLESArray *a, uint32_t stride,
+                                  uint32_t first, uint32_t count,
+                                  uint64_t want, size_t need, bool es2,
+                                  uint64_t *span_lo, size_t *span_len)
+{
+    uint64_t lo = want, hi = want + need;
+
+    if (es2) {
+        for (unsigned j = 0; j < GLES_MAX_ATTRIBS; j++) {
+            gles_interleaved_consider(&gh.attr[j], a->ptr, stride, first,
+                                      count, &lo, &hi);
+        }
+    } else {
+        const GLESArray *fixed[] = {
+            &gh.vertex, &gh.color, &gh.normal, &gh.pointsize
+        };
+        for (unsigned j = 0; j < ARRAY_SIZE(fixed); j++) {
+            gles_interleaved_consider(fixed[j], a->ptr, stride, first,
+                                      count, &lo, &hi);
+        }
+        for (unsigned j = 0; j < GLES_MAX_TEXUNITS; j++) {
+            gles_interleaved_consider(&gh.texcoord[j], a->ptr, stride, first,
+                                      count, &lo, &hi);
+        }
+    }
+    *span_lo = lo;
+    *span_len = (size_t)(hi - lo);
+}
