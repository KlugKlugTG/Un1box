+static bool gles_vbo_array_spans(const GLESArray *a, uint32_t hi, bool es2)
+{
+    uint32_t esz, stride;
+
+    if (!a->enabled) {
+        return true;
+    }
+    if (!a->vbo) {
+        return false;
+    }
+    if (es2 ? (a->type == GLES_FIXED)
+            : gles_needs_widen(a->client_state, a->type)) {
+        return false;
+    }
+    esz = gles_type_size(a->type) * a->size;
+    if (!esz) {
+        return false;
+    }
+    stride = a->stride ? a->stride : esz;
+    return (uint64_t)a->ptr + (uint64_t)stride * hi + esz <= a->vbo->size;
+}
+
+static bool gles_es2_vbo_can_span(uint32_t hi)
+{
+    bool any = false;
+
+    for (unsigned i = 0; i < GLES_MAX_ATTRIBS; i++) {
+        if (gh.attr[i].enabled) {
+            any = true;
+            if (!gles_vbo_array_spans(&gh.attr[i], hi, true)) {
+                return false;
+            }
+        }
+    }
+    return any;
+}
+
+static bool gles_es1_vbo_can_span(uint32_t hi)
+{
+    const GLESArray *arrays[] = { &gh.vertex, &gh.color, &gh.normal };
+
+    if (!gh.vertex.enabled || gh.pointsize.enabled) {
+        return false;
+    }
+    for (unsigned i = 0; i < ARRAY_SIZE(arrays); i++) {
+        if (!gles_vbo_array_spans(arrays[i], hi, false)) {
+            return false;
+        }
+    }
+    for (unsigned i = 0; i < GLES_MAX_TEXUNITS; i++) {
+        if (!gles_vbo_array_spans(&gh.texcoord[i], hi, false)) {
+            return false;
+        }
+    }
     return true;
 }
 
+static void gles_index_bounds(const uint8_t *idx, uint32_t count, uint32_t isz,
+                              uint32_t *lo_out, uint32_t *hi_out)
+{
+    uint32_t i = 0, lo = UINT32_MAX, hi = 0;
+
+#if defined(__aarch64__) && defined(__ARM_NEON)
+    if (isz == 2 && count >= 8) {
+        uint16x8_t vmin = vdupq_n_u16(0xffffu);
+        uint16x8_t vmax = vdupq_n_u16(0);
+        for (; i + 8 <= count; i += 8) {
+            uint16x8_t v = vld1q_u16((const uint16_t *)(idx + (size_t)i * 2));
+            vmin = vminq_u16(vmin, v);
+            vmax = vmaxq_u16(vmax, v);
+        }
+        lo = vminvq_u16(vmin);
+        hi = vmaxvq_u16(vmax);
+    } else if (isz == 1 && count >= 16) {
+        uint8x16_t vmin = vdupq_n_u8(0xffu);
+        uint8x16_t vmax = vdupq_n_u8(0);
+        for (; i + 16 <= count; i += 16) {
+            uint8x16_t v = vld1q_u8(idx + i);
+            vmin = vminq_u8(vmin, v);
+            vmax = vmaxq_u8(vmax, v);
+        }
+        lo = vminvq_u8(vmin);
+        hi = vmaxvq_u8(vmax);
+    }
+#endif
+    for (; i < count; i++) {
+        uint32_t v = (isz == 1) ? idx[i] : lduw_le_p(idx + (size_t)i * 2);
+        lo = MIN(lo, v);
+        hi = MAX(hi, v);
+    }
+    *lo_out = lo;
+    *hi_out = hi;
+}
