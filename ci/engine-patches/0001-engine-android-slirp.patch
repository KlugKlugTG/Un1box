 pc.write_text('#!/bin/sh\nexec pkg-config --static "$@"\n');pc.chmod(0o755);env['PKG_CONFIG']=str(pc)
-args=[src/'configure','--target-list=arm-softmmu','--without-default-features','--without-default-devices','--with-devices-arm=portable','--enable-tcg','--enable-pixman','--enable-gcrypt','--python=/usr/bin/python3','--disable-docs','--disable-tools','--disable-werror','--disable-pie','--extra-cflags=-fPIC -DQEMU_IOS_PORTABLE_CRYPTO '+os.environ.get('LT_ENGINE_CFLAGS','').strip(),'--extra-ldflags=-L'+str(prefix/'lib')+' '+os.environ.get('LT_ENGINE_CFLAGS','').strip()+' '+os.environ.get('LT_ENGINE_CFLAGS','').strip(),'--audio-drv-list=']
+args=[src/'configure','--target-list=arm-softmmu','--without-default-features','--without-default-devices','--with-devices-arm=portable','--enable-tcg','--enable-pixman','--enable-gcrypt','--enable-slirp','--python=/usr/bin/python3','--disable-docs','--disable-tools','--disable-werror','--disable-pie','--extra-cflags=-fPIC -DQEMU_IOS_PORTABLE_CRYPTO '+os.environ.get('LT_ENGINE_CFLAGS','').strip(),'--extra-ldflags=-L'+str(prefix/'lib')+' '+os.environ.get('LT_ENGINE_CFLAGS','').strip()+' '+os.environ.get('LT_ENGINE_CFLAGS','').strip(),'--audio-drv-list=']
 if a.cpp_standard:
  if a.abi!='linux':p.error('--cpp-standard is a Linux packaging option')
